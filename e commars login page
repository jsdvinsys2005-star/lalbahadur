<!DOCTYPE html>
<html>
<head>
    <title>Online Shopping Website</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
        }

        header {
            background: #222;
            color: white;
            padding: 20px;
            text-align: center;
        }

        nav {
            background: #333;
            padding: 10px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 20px;
        }

        .products {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
            padding: 30px;
        }

        .card {
            background: white;
            width: 250px;
            padding: 20px;
            text-align: center;
            border-radius: 10px;
            box-shadow: 0 0 10px gray;
        }

        .card img {
            width: 200px;
            height: 150px;
        }

        .price {
            color: green;
            font-size: 20px;
            font-weight: bold;
        }

        button {
            background: orange;
            color: white;
            border: none;
            padding: 12px;
            width: 100%;
            cursor: pointer;
            border-radius: 5px;
        }

        button:hover {
            background: darkorange;
        }

        footer {
            background: #222;
            color: white;
            text-align: center;
            padding: 15px;
        }

    </style>

</head>

<body>

<header>
    <h1>Krishna Online Shop</h1>
    <p>Best Products At Best Price</p>
</header>

<nav>
    <a href="#">Home</a>
    <a href="#">Products</a>
    <a href="#">Cart</a>
    <a href="#">Contact</a>
</nav>


<div class="products">

    <div class="card">
        <img src="https://via.placeholder.com/200">
        <h2>Mobile Phone</h2>
        <p>Latest Smartphone</p>
        <p class="price">₹15000</p>
        <button>Add To Cart</button>
    </div>


    <div class="card">
        <img src="https://via.placeholder.com/200">
        <h2>Laptop</h2>
        <p>High Performance Laptop</p>
        <p class="price">₹50000</p>
        <button>Add To Cart</button>
    </div>


    <div class="card">
        <img src="https://via.placeholder.com/200">
        <h2>Headphones</h2>
        <p>Wireless Headphone</p>
        <p class="price">₹2000</p>
        <button>Add To Cart</button>
    </div>


    <div class="card">
        <img src="https://via.placeholder.com/200">
        <h2>Smart Watch</h2>
        <p>Digital Smart Watch</p>
        <p class="price">₹3000</p>
        <button>Add To Cart</button>
    </div>

</div>


<footer>
    <p>© 2026 Krishna Online Shop | All Rights Reserved</p>
</footer>

</body>
</html>
