<!DOCTYPE html>
<html>
<head>
    <title>Instagram Login</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background: #fafafa;
        }

        .login-box {
            width: 350px;
            margin: 80px auto;
            background: white;
            border: 1px solid #ddd;
            padding: 40px;
            text-align: center;
        }

        .logo {
            font-size: 40px;
            font-weight: bold;
            font-family: cursive;
            margin-bottom: 30px;
        }

        input {
            width: 90%;
            padding: 12px;
            margin: 8px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        button {
            width: 97%;
            padding: 12px;
            margin-top: 10px;
            background: #3897f0;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 16px;
        }

        button:hover {
            background: #1877d1;
        }

        a {
            text-decoration: none;
            color: #00376b;
            font-size: 14px;
        }

        .signup {
            margin-top: 20px;
            border: 1px solid #ddd;
            padding: 20px;
        }
    </style>
</head>

<body>

    <div class="login-box">

        <div class="logo">Instagram</div>

        <form>
            <input type="text" placeholder="Phone number, username, or email">
            <input type="password" placeholder="Password">

            <button type="submit">Log In</button>
        </form>

        <br>

        <a href="#">Forgot password?</a>

        <div class="signup">
            Don't have an account?
            <a href="#">Sign up</a>
        </div>

    </div>

</body>
</html>
